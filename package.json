{
  "name": "prohodnaya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Проходная — казуальная игра для Яндекс Игр и itch.io (Phaser 3 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "dev:itch": "vite --mode itch",
    "build": "tsc --noEmit && vite build",
    "build:itch": "tsc --noEmit && vite build --mode itch",
    "preview": "vite preview",
    "promo": "vite --port 5190 --strictPort",
    "promo:save": "node promo/save-server.mjs",
    "dist": "npm run build && powershell -NoProfile -Command \"Compress-Archive -Path 'dist/*' -DestinationPath 'prohodnaya-yandex.zip' -Force\"",
    "dist:itch": "npm run build:itch && powershell -NoProfile -Command \"Compress-Archive -Path 'dist/*' -DestinationPath 'prohodnaya-itch.zip' -Force\"",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src index.html"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "phaser": "^3.85.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "ws": "^8.23.0"
  }
}
